VITE_META_APP_ID=
VITE_META_LOGIN_CONFIG_ID=
# FB.login extras.featureType — leave empty to use whatsapp_business_app_onboarding (WhatsApp Business app coexistence flow).
VITE_META_FEATURE_TYPE=
# Leave empty to POST via same-origin Vite dev proxy → http://localhost:3003 (see vite.config.js).
VITE_WHATSAPP_INGESTION_URL=
# Real key-vault Service UUID (POST /api/v1/services) — must not be 00000000-0000-0000-0000-000000000000
VITE_WHATSAPP_SERVICE_ID=
# TPA organisation id stored on whatsapp_channels.org_id
VITE_WHATSAPP_ORG_ID=
# Zone / insurer code stored on whatsapp_channels.zone_id (landing path segment)
VITE_WHATSAPP_ZONE_ID=
# TEMPORARY: hardcoded vault token for dev/testing until proper vault provisioning is wired into this app. Replace with real auth flow before production.
VITE_VAULT_TOKEN=
