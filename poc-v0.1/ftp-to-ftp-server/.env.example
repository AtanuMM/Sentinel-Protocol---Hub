# HTTP server — loaded by dotenv before `src/server.ts` reads `config.port`
PORT=3000
HOST=0.0.0.0

DB_URL=postgres://postgres:postgres123@localhost:5432/sentinel_mdm
REDIS_URL=redis://localhost:6380
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# MinIO (ingestion infra + @sentinel/storage-core landing writer when STORAGE_PROVIDER=MINIO)
# MINIO_ENDPOINT may be a full URL (http://localhost:9000) or host-only with MINIO_PORT / MINIO_USE_SSL
STORAGE_PROVIDER=MINIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sentinel-landing-bucket

# AWS S3 (@sentinel/storage-core landing writer when STORAGE_PROVIDER=S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET=ngenclaims-landing-bucket
AWS_ENDPOINT=https://ngenclaims-landing-bucket.s3.ap-south-1.amazonaws.com

KAFKA_BROKER=localhost:9092

VAULT_URL=http://localhost:8000/api/v1
KMS_BASE_URL=http://localhost:8000
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# FTP polling (KMS-backed source list + storage-core landing write)
POLL_INTERVAL_MS=300000
POLL_CONCURRENCY=5

# Optional
# WEBHOOK_SECRET=
# LANDING_BUCKET=sentinel-landing-bucket
# INGESTION_TOPIC=claims-ingestion-trace
