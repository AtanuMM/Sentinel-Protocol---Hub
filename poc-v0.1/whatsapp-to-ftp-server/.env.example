# HTTP server — use a different port than ftp-to-ftp-server / email-to-ftp-server when all run locally
PORT=3002
HOST=0.0.0.0

DB_URL=postgres://postgres:postgres123@localhost:5432/sentinel_mdm
REDIS_URL=redis://localhost:6379
# If using docker-compose redis service (port 6380:6379), use: redis://localhost:6380
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# MinIO (ingestion infra + @sentinel/storage-core landing writer when STORAGE_PROVIDER=MINIO)
# MINIO_ENDPOINT may be a full URL (http://localhost:9000) or host-only with MINIO_PORT / MINIO_USE_SSL
STORAGE_PROVIDER=MINIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sentinel-landing-bucket
KAFKA_BROKER=localhost:9092

VAULT_URL=http://localhost:8000/api/v1
# Optional — when set, vault list uses GET {KMS_BASE_URL}/api/v1/secrets/{serviceId}
# KMS_BASE_URL=http://localhost:8000
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

WHATSAPP_VERIFY_TOKEN=sentinel_webhook_verify_2026
WHATSAPP_APP_SECRET=<meta_app_secret_from_developer_dashboard>
META_APP_ID=948840568153510
WHATSAPP_RAW_EVENTS_TOPIC=whatsapp-raw-events
