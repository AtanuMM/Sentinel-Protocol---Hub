# Database — same Postgres as ingestion services
DB_URL=postgres://postgres:postgres123@localhost:5432/sentinel_mdm

# Kafka
KAFKA_BROKER=localhost:9092
POLL_JOBS_TOPIC=poll-jobs

# KMS
KMS_BASE_URL=http://localhost:8000
VAULT_URL=http://localhost:8000/api/v1

# Scheduler
POLL_INTERVAL_MS=300000

# Worker pool
POLL_CONCURRENCY=10

# Redis dedup
REDIS_URL=redis://localhost:6380
DEDUP_TTL_SEC=604800

# Storage (passed through to storage-core)
STORAGE_PROVIDER=MINIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sentinel-landing-bucket

# Encryption — same key as ingestion services
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
